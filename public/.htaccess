<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compressão do texto (HTML, CSS, JS, JSON, SVG): o pacote principal do site cai de ~344 KiB para ~110 KiB.
# Sem isso o Lighthouse reprova "Enable text compression" e a nota do celular cai bastante.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>

# Cache longo só para os arquivos do build do Vite, que têm hash no nome (ex.: main-Bj2DYWzV.js):
# quando o conteúdo muda, o nome muda, então o navegador nunca fica com versão velha.
<IfModule mod_headers.c>
    <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|svg|png|jpe?g|webp|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Cabeçalhos de segurança (apontados pelo OWASP ZAP). Valem para o site e para o painel /admin.
<IfModule mod_headers.c>
    # Impede que o navegador "adivinhe" o tipo de um arquivo (ex.: tratar um upload como script).
    Header always set X-Content-Type-Options "nosniff"
    # Impede que outro site coloque este numa moldura (clickjacking). O painel e o site não usam molduras.
    Header always set X-Frame-Options "SAMEORIGIN"
    # Não manda o endereço completo das páginas para outros sites ao seguir um link.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # O site não usa câmera, microfone nem localização.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Esconde a versão do PHP. (A versão do servidor, "Server:", só se esconde na configuração do servidor.)
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # HSTS: obriga o navegador a usar sempre HTTPS. DESLIGADO de propósito: o navegador guarda a regra por
    # 1 ano, então só ative depois de confirmar que o site inteiro funciona em HTTPS (tire o # da linha abaixo).
    # Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>
