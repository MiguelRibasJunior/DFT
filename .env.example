# ==============================================================================
# Devs From Tomorrow — Configuração de Ambiente Local (.env)
# ==============================================================================

# Identificação da Aplicação
APP_NAME="Devs From Tomorrow"
APP_ENV=local
# Gerada por `php artisan key:generate` (nunca versionar uma chave real: ela cifra sessões e cookies)
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Idioma e Internacionalização
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Segurança e Criptografia
BCRYPT_ROUNDS=12

# Logs do Sistema
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Banco de Dados Local (SQLite sem necessidade de servidor MySQL)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Gerenciamento de Sessão e Cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Notificações e Envio de E-mails
MAIL_MAILER=log

# Credenciais Iniciais do Administrador
ADMIN_EMAIL=admin@devsfromtomorrow.com
# Em desenvolvimento, se ficar vazia, o seeder usa uma senha de teste. Em PRODUÇÃO é obrigatória:
# mínimo de 12 caracteres e nenhuma senha de exemplo (o seeder recusa).
ADMIN_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=contato@devsfromtomorrow.com

# Configurações do Frontend (Vite)
VITE_SITE_URL=http://localhost:8000
VITE_API_BASE_URL=/api
