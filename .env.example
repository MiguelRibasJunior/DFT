# Devs From Tomorrow — Configuração de Ambiente (Modelo)
APP_NAME="Devs From Tomorrow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://devsfromtomorrow.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

ADMIN_EMAIL=admin@devsfromtomorrow.com
ADMIN_PASSWORD=alterar_para_senha_segura_no_env
ADMIN_NOTIFICATION_EMAIL=contato@devsfromtomorrow.com

# Configurações Públicas do Frontend
VITE_SITE_URL=https://devsfromtomorrow.com
VITE_API_BASE_URL=/api

