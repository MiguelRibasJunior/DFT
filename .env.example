# Devs From Tomorrow — Example Environment Configuration
APP_NAME="Devs From Tomorrow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://devsfromtomorrow.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# No auth/queue system in this app — plain file/sync drivers avoid needing
# the users/cache/jobs migrations that Laravel's "database" defaults require.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log

VITE_ADMIN_PASSWORD=your_secure_admin_password_here
VITE_FORM_SUBMIT_EMAIL=nathalia.sampaio@aluno.unc.br
VITE_SITE_URL=https://devsfromtomorrow.com
VITE_API_BASE_URL=/api
